# --- Local development only. In AWS these come from Secrets Manager / SSM. ---

# Slack
# Used ONLY to verify inbound request signatures at the ingress Lambda.
SLACK_SIGNING_SECRET=

# Slack bot token (xoxb-...). In AWS this is resolved from Secrets Manager
# via SLACK_BOT_TOKEN_SECRET_NAME; locally you may inline it.
SLACK_BOT_TOKEN=
SLACK_BOT_TOKEN_SECRET_NAME=bettercode/slack/bot-token

# LLM provider
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_SECRET_NAME=bettercode/llm/anthropic-api-key

# GitHub (read-only). Use a deploy key or GitHub App installation token.
# Prefer a GitHub App; deploy key path shown for the MVP.
GITHUB_DEPLOY_KEY_SECRET_NAME=bettercode/github/engage-workspace-deploy-key

# AWS resource handles (set by CDK at deploy time; override locally if needed)
JOBS_QUEUE_URL=
DDB_EVENTS_TABLE=bettercode-events
DDB_JOBS_TABLE=bettercode-jobs
DDB_REPOMETA_TABLE=bettercode-repo-meta
DDB_AUDIT_TABLE=bettercode-audit
REPO_CACHE_ROOT=/mnt/repos          # EFS mount in Lambda; /tmp/bettercode locally

# Behavior
LOG_LEVEL=info
BETTERCODE_CONFIG_PATH=bettercode.config.yaml
